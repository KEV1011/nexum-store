// Nexum MaaS — Schema de base de datos
// Stack: PostgreSQL + Prisma ORM
//
// Para aplicar:
//   npx prisma migrate dev --name init
// Para generar el cliente:
//   npx prisma generate

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Usuarios (clientes) ───────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  phone     String    @unique
  name      String?
  email     String?   @unique
  avatarUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isActive  Boolean   @default(true)
  // Cuenta borrada a petición del titular (App Store / Play exigen poder
  // hacerlo desde la app). NO se borra la fila: sus viajes liquidados son la
  // contabilidad del conductor y de la empresa, y desaparecerían con ella. Se
  // anonimiza — teléfono a un valor lápida, nombre/email/foto fuera — y esta
  // fecha deja constancia de cuándo y de que fue el titular quien lo pidió.
  deletedAt DateTime?

  // Verificación de identidad del pasajero (anti-fraude/anti-robo). Mismo modelo
  // env-gated que el KYC del conductor. El conductor ve "cliente verificado".
  kycStatus    KycStatus @default(PENDING)
  kycProvider  String?
  kycReference String?
  kycCheckedAt DateTime?
  selfieUrl    String?

  // Token FCM del dispositivo para notificaciones push (null = sin registrar).
  fcmToken String?

  /// Reputación del pasajero, promediada de los viajes que sus conductores
  /// calificaron. Null mientras nadie lo haya calificado — el conductor ve
  /// «Nuevo», no un 5,0 escrito a mano como hasta ahora.
  rating      Float?
  ratingCount Int    @default(0)

  // Trusted contact for the SOS / share-trip safety features.
  trustedContactName  String?
  trustedContactPhone String?

  // Programa de referidos: código propio para compartir y quién lo refirió.
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("UserReferrals")

  addresses         Address[]
  orders            Order[]
  trips             Trip[]             @relation("TripPassenger")
  errands           Errand[]
  intercityBookings IntercityBooking[]
  seatBookings      SeatBooking[]
  emergencyEvents   EmergencyEvent[]
  promoRedemptions  PromoRedemption[]
  magicLinks        MagicLink[]

  @@map("users")
}

// ── Promociones (cupones y referidos) ─────────────────────────────────────────

enum PromoType {
  PERCENT
  FIXED
}

enum PromoScope {
  ALL
  TRIPS
  ORDERS
  /// Pasajes de salidas intermunicipales. Solo lo emiten las empresas: ver
  /// `lib/cupon-pasaje.ts` para por qué un cupón de plataforma no puede
  /// aplicarse mientras el pasaje no se pague por la app.
  INTERCITY
}

model PromoCode {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           PromoType
  /// PERCENT: 1–100; FIXED: monto en COP.
  value          Float
  scope          PromoScope @default(ALL)
  minAmount      Float      @default(0)
  /// Tope del descuento en COP para cupones PERCENT (null = sin tope).
  maxDiscount    Float?
  /// null = sin límite global de canjes.
  maxRedemptions Int?
  perUserLimit   Int        @default(1)
  expiresAt      DateTime?
  active         Boolean    @default(true)
  /// Teléfono del admin que lo creó, o "referral" para los generados por referidos.
  createdBy      String?
  /// Si es un cupón personal, solo este usuario puede canjearlo.
  ownerUserId    String?
  /// Empresa que lo emitió y que asume el descuento. NULL = cupón de la
  /// plataforma, que lo absorbe con su comisión. Un cupón de empresa solo vale
  /// en las salidas de ESA empresa.
  operatorId     String?
  createdAt      DateTime   @default(now())

  redemptions PromoRedemption[]

  @@map("promo_codes")
}

model PromoRedemption {
  id           String   @id @default(cuid())
  promoCodeId  String
  userId       String
  /// 'trip' | 'order'
  context      String
  amountBefore Float
  discount     Float
  createdAt    DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([promoCodeId])
  @@index([userId])
  @@map("promo_redemptions")
}

// ── OTP Sessions ──────────────────────────────────────────────────────────────

model OtpSession {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])
  // Sin relación a User por `phone`: el OTP es para login/registro y el número
  // puede no existir aún en `users`. La FK otp_sessions_phone_fkey rompía el
  // envío de OTP para cualquier teléfono no registrado.

  @@index([phone])
  @@map("otp_sessions")
}

// ── Conductores ───────────────────────────────────────────────────────────────

model Driver {
  id                  String           @id @default(cuid())
  phone               String           @unique
  name                String
  email               String?          @unique
  avatarUrl           String?
  documentType        String?
  documentNumber      String?          @unique
  licenseNumber       String?          @unique
  status              DriverStatus     @default(OFFLINE)
  isVerified          Boolean          @default(false)
  // ── KYC / verificación de identidad ──────────────────────────────────────
  // isVerified = documentos aprobados; kycStatus = identidad validada (cédula/
  // licencia contra registros + selfie/liveness). Un conductor está "habilitado
  // para conducir" solo si AMBOS pasan (gating activable con KYC_ENFORCE).
  kycStatus           KycStatus        @default(PENDING)
  kycProvider         String? // 'manual' | 'truora' | ... (quién validó)
  kycReference        String? // id de la verificación del proveedor
  kycCheckedAt        DateTime?
  selfieUrl           String? // foto selfie para comparación/liveness
  // ── Antecedentes (env-gated) ─────────────────────────────────────────────
  backgroundStatus    BackgroundStatus @default(UNCHECKED)
  backgroundProvider  String?
  backgroundReference String?
  backgroundCheckedAt DateTime?
  // Antifraude: contador de eventos GPS sospechosos (saltos/velocidad imposible).
  fraudFlags          Int              @default(0)
  // ── Kill-switch documental ───────────────────────────────────────────────
  // Estado calculado por el chequeo diario de vencimientos (document-expiry):
  // BLOCKED = algún documento obligatorio vencido. blockedReason lista cuáles.
  complianceStatus    ComplianceStatus @default(CLEAR)
  blockedReason       String?
  blockedAt           DateTime?
  // Disponibilidad para recibir solicitudes de viajes intermunicipales.
  // Default TRUE (paridad con el urbano): un conductor ONLINE recibe
  // intermunicipales salvo que lo apague en Preferencias de servicio.
  intercityEnabled    Boolean          @default(true)
  // Preferencias de servicio: qué tipos de solicitud recibe el conductor.
  // El matching las respeta al elegir candidatos (default: todo activo).
  acceptsTrips        Boolean          @default(true)
  acceptsErrands      Boolean          @default(true)
  acceptsOrders       Boolean          @default(true)
  // Viajes encadenados: recibir la siguiente solicitud mientras se termina la
  // actual, ya cerca del destino (como Uber y DiDi). Sin esto el conductor
  // llega a dejar al pasajero y no ve el servicio que acaba de salir a la
  // vuelta de la esquina. Se puede apagar: hay quien prefiere cerrar un viaje
  // antes de pensar en el siguiente.
  acceptsChained      Boolean          @default(true)
  // Token FCM del dispositivo para notificaciones push (null = sin registrar).
  fcmToken            String?
  /// Reputación REAL, promediada de los viajes que los pasajeros calificaron.
  /// Null mientras nadie lo haya calificado — antes era `@default(5.0)` y
  /// NADIE la escribía nunca, así que todos los conductores enseñaban el mismo
  /// cinco de fábrica al pasajero que decidía si subirse a su carro.
  rating              Float?
  ratingCount         Int              @default(0)
  totalTrips          Int              @default(0)
  bio                 String?
  bankName            String?
  bankAccountType     String?
  bankAccountNumber   String?
  // Afiliación a una empresa de transporte (null = conductor independiente).
  operatorId          String?
  employmentType      EmploymentType?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  // Cuenta borrada a petición del titular. Ver el comentario en User.deletedAt:
  // se anonimiza en vez de borrarse porque sus viajes liquidados sostienen la
  // liquidación de la empresa, las cuentas de cobro y los remitos firmados.
  deletedAt           DateTime?

  // Trusted contact for the SOS / share-trip safety features.
  trustedContactName  String?
  trustedContactPhone String?

  // Última posición conocida
  lastLat    Float?
  lastLng    Float?
  lastSeenAt DateTime?

  // Posición geográfica para matching por cercanía (PostGIS).
  // Prisma no soporta tipos PostGIS de forma nativa: la columna se declara como
  // Unsupported para que el cliente la conozca pero NO la gestione. Se ESCRIBE y
  // se CONSULTA exclusivamente vía SQL raw (ST_MakePoint / ST_DWithin / ST_Distance)
  // desde matching.service.ts. El índice GIST y la columna se crean en la
  // migración manual `add_postgis`.
  geo Unsupported("geography(Point, 4326)")?

  vehicles         Vehicle[]
  trips            Trip[]
  otpSessions      OtpSession[]
  earnings         DriverEarning[]
  documents        DriverDocument[]
  emergencyEvents  EmergencyEvent[]
  payouts          Payout[]
  operator         Operator?         @relation(fields: [operatorId], references: [id])
  fleetAssignments FleetAssignment[]

  // Plaza donde se le vio por última vez, refrescada con el latido. A
  // diferencia de la del viaje, esta NO es historia: dice dónde está hoy.
  citySlug String?

  @@index([status])
  @@index([operatorId])
  @@index([citySlug])
  @@map("drivers")
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_TRIP
}

model DriverDocument {
  id              String         @id @default(cuid())
  driverId        String
  type            DocumentType
  fileUrl         String
  status          DocumentStatus @default(PENDING)
  expiresAt       String?
  // OCR (env-gated): campos extraídos (JSON string) y confianza del proveedor,
  // para que el admin los vea junto a la imagen al revisar.
  ocrFields       String?
  ocrConfidence   Float?
  rejectionReason String?
  reviewedBy      String?
  uploadedAt      DateTime       @default(now())
  reviewedAt      DateTime?

  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([driverId, type])
  @@index([driverId])
  @@index([status])
  @@map("driver_documents")
}

enum DocumentType {
  CEDULA
  LICENSE
  SOAT
  PROPERTY_CARD
  PROFILE_PHOTO
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KycStatus {
  PENDING // aún no envía verificación de identidad
  IN_REVIEW // enviada; en revisión (proveedor o admin manual)
  VERIFIED // identidad confirmada
  REJECTED // no pasó la verificación
}

// Cumplimiento documental del conductor (kill-switch de documentos vencidos).
// CLEAR = todo vigente; EXPIRING = algún obligatorio vence pronto (aviso);
// BLOCKED = obligatorio VENCIDO → con DOC_KILL_SWITCH_ENFORCE=true se cae del
// matching y no puede ponerse en línea hasta renovar.
enum ComplianceStatus {
  CLEAR
  EXPIRING
  BLOCKED
}

// Antecedentes del conductor (env-gated, BACKGROUND_CHECK_PROVIDER).
// UNCHECKED = nunca consultado; PENDING = consulta en curso (jamás bloquea);
// CLEAR = sin hallazgos; HIT = hallazgo → revisión del admin (no auto-aprueba).
enum BackgroundStatus {
  UNCHECKED
  PENDING
  CLEAR
  HIT
}

model Vehicle {
  id                  String      @id @default(cuid())
  driverId            String
  type                VehicleType
  brand               String
  model               String
  year                Int
  plate               String      @unique
  color               String
  isActive            Boolean     @default(true)
  // Flota de empresa (null = vehículo de conductor independiente).
  operatorId          String?
  operationCardNo     String? // tarjeta de operación (taxi/intermunicipal)
  capacity            Int? // # de pasajeros
  capacityKg          Int? // capacidad de carga en kg (turbo/camión/mula)
  internalCode        String? // "móvil 042" interno de la empresa
  // ── Documentos y cumplimiento ────────────────────────────────────────────
  photoUrl            String? // foto del vehículo
  soatExpiry          DateTime? // vencimiento del SOAT
  rtmExpiry           DateTime? // vencimiento de la revisión técnico-mecánica
  operationCardExpiry DateTime? // vencimiento de la tarjeta de operación
  createdAt           DateTime    @default(now())

  driver           Driver            @relation(fields: [driverId], references: [id])
  trips            Trip[]
  operator         Operator?         @relation(fields: [operatorId], references: [id])
  fleetAssignments FleetAssignment[]

  @@index([operatorId])
  @@map("vehicles")
}

enum VehicleType {
  PARTICULAR
  TAXI
  MOTO
  // Vehículos de carga (empresas de transporte de mercancía / acarreos).
  TURBO // camión mediano (NPR y similares)
  CAMION // camión sencillo
  MULA // tractocamión / articulado
  // Pasajeros intermunicipal. Antes no existían: una empresa que mueve gente
  // entre municipios no podía ni declarar con qué viaja, y sin eso no hay
  // mapa de sillas que dibujar (ver `lib/mapa-asientos.ts`).
  VAN // tipo Hiace: 3 por fila, pasillo lateral
  BUSETA // 2+2 con la puerta partiendo la primera fila
  BUS // 2+2 corridas
}

// ── Negocios aliados ──────────────────────────────────────────────────────────

model Business {
  id              String           @id @default(cuid())
  name            String
  ownerName       String?
  category        BusinessCategory
  address         String
  lat             Float?
  lng             Float?
  phone           String?
  whatsapp        String?
  rating          Float?
  /// Promoción de la tienda: «$descuento comprando $mínimo». Las dos o
  /// ninguna. El MISMO cálculo (`promoDeTienda`) alimenta el banner y el
  /// cobro, para que la pantalla no prometa lo que la caja no aplica.
  promoMinAmount  Int?
  promoDiscount   Int?
  /// Vigencia de la promoción. Null = siempre. Con fecha, se apaga SOLA —
  /// un «solo este fin de semana» que hay que acordarse de quitar el lunes
  /// sigue puesto en marzo.
  promoFrom       DateTime?
  promoUntil      DateTime?
  /// Horario estructurado: [{dia:0-6, abre:"HH:MM", cierra:"HH:MM"}].
  /// Vacío/null = sin horario declarado ⇒ se considera SIEMPRE abierta, que
  /// es como se comportaban los negocios ya registrados. `openingHours` (texto
  /// libre) se conserva para los que aún no lo han declarado.
  hours           Json?
  /// Pausa temporal que se levanta sola. Distinta de apagar el interruptor:
  /// la cocina copada para media hora, no cierra el día.
  pausedUntil     DateTime?
  pauseReason     String?
  /// Reputación REAL. `rating` es null mientras nadie haya calificado — antes
  /// era 5.0 por defecto y la app enseñaba una nota que nadie dio.
  ratingCount     Int              @default(0)
  etaMinutes      Int              @default(30)
  deliveryFee     Float            @default(2500)
  // isOpen = cuenta activa (gate de acceso al portal, lo controla el admin/registro).
  isOpen          Boolean          @default(true)
  // acceptingOrders = vitrina abierta/cerrada (pausa de pedidos que el dueño
  // controla desde el portal). Distinto de isOpen para no perder el acceso al
  // portal al cerrar. Cerrado = el negocio se ve como "Cerrado" y no toma pedidos.
  acceptingOrders Boolean          @default(true)
  // Horario de atención en texto libre (ej: "Lun-Sáb 8am-9pm"). Informativo.
  openingHours    String?

  /// La plaza del comercio, con EL MISMO criterio que la de viajes y
  /// conductores (`plazaDeCoordenadas`: centroide más cercano, 40 km). Si aquí
  /// se usara otro, un pedido podría ser «de Cúcuta» para el comercio y «de
  /// otra parte» para el tablero.
  citySlug  String?
  /// A qué otras ciudades despacha, a qué precio y en cuánto tiempo.
  /// `[{city, fee, etaHours}]` — ver `lib/destinos-envio.ts`.
  /// VACÍA SIGNIFICA «A NINGUNA», que es como nacen todos los comercios ya
  /// registrados: lo contrario habría abierto de golpe el catálogo local a
  /// todo el país el día del despliegue.
  shipsTo   Json?
  // Foto de portada del local (subida por el dueño desde el portal). Null = sin
  // portada (el cliente cae al color/ícono de la categoría).
  imageUrl  String?
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  orders   Order[]

  @@index([category])
  @@map("businesses")
}

enum BusinessCategory {
  RESTAURANT
  SUPERMARKET
  PHARMACY
  OTHER
}

model Product {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  description    String?
  price          Float
  /// Precio ANTES de la rebaja, para el tachado. Null = sin descuento.
  /// Se valida al guardar (`saneaPrecioAntes`): un «antes» inflado no es una
  /// decisión de precio, es publicidad engañosa.
  compareAtPrice Float?
  category       String   @default("General")
  /// Orden dentro de la carta. Una carta se lee en un orden concreto —
  /// entradas antes que postres— y por fecha de creación salen mezclados.
  /// Las secciones se ordenan por el menor sortOrder de sus productos, así
  /// que ordenar productos ordena también la carta.
  sortOrder      Int      @default(0)
  // Foto de portada (primera/principal). La galería adicional vive en `photos`.
  imageUrl       String?
  isAvailable    Boolean  @default(true)
  // ── Inventario (supermercados y farmacias) ────────────────────────────────
  // Todo opcional: un restaurante no lleva código de barras ni stock, y con
  // estos campos en null se comporta exactamente como antes.
  barcode        String? // EAN-13 / UPC impreso en el empaque
  sku            String? // código interno del negocio
  /// null = el negocio NO controla inventario de este producto (caso
  /// restaurante: la cocina decide). Un número sí se descuenta al vender.
  stock          Int?
  unit           String? // 'unidad' | 'kg' | 'g' | 'litro' | 'libra'
  brand          String?
  createdAt      DateTime @default(now())

  business     Business       @relation(fields: [businessId], references: [id])
  orderLines   OrderLine[]
  photos       ProductPhoto[]
  optionGroups OptionGroup[]

  @@index([businessId])
  // El escáner busca por código dentro de UN negocio: el mismo EAN puede
  // existir en varios comercios y cada uno tiene su producto y su precio.
  @@index([businessId, barcode])
  @@map("products")
}

// Grupo de opciones/variantes de un producto (ej: "Tamaño", "Adiciones",
// "Quitar"). `minSelect`/`maxSelect` controlan cuántas opciones puede elegir el
// cliente (maxSelect=1 → selección única tipo radio; >1 → múltiple tipo check).
model OptionGroup {
  id        String   @id @default(cuid())
  productId String
  name      String
  required  Boolean  @default(false)
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductOption[]

  @@index([productId])
  @@map("option_groups")
}

// Una opción dentro de un grupo (ej: "Grande" +3000, "+Queso" +2000,
// "Sin cebolla" +0). `priceDelta` se suma al precio base del producto.
model ProductOption {
  id          String  @id @default(cuid())
  groupId     String
  name        String
  priceDelta  Float   @default(0)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_options")
}

// Galería de fotos adicionales de un producto (además de `Product.imageUrl`).
model ProductPhoto {
  id        String   @id @default(cuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_photos")
}

// ── Pedidos de domicilio ──────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  orderRef        String      @unique
  userId          String?
  businessId      String
  driverId        String?
  // Empresa del conductor al momento de aceptar (sellado para liquidación).
  operatorId      String?
  status          OrderStatus @default(CONFIRMED)
  deliveryAddress String
  deliveryLat     Float?
  deliveryLng     Float?

  /// Plaza del comercio y plaza de la dirección de entrega, SELLADAS al crear.
  /// Se guardan en vez de leerse del comercio al consultar porque si mañana el
  /// dueño corrige su ubicación, el pedido de ayer no puede cambiar de ciudad.
  originCitySlug String?
  destCitySlug   String?
  /// Si este pedido se VENDIÓ como envío a otra ciudad. Es una decisión sellada,
  /// no una derivación: con `destCitySlug` sin resolver, un pedido cobrado como
  /// intermunicipal se convertiría en local al recargarlo.
  isIntercity    Boolean @default(false)
  /// Lo que el comercio cobró por el tramo intermunicipal. Va aparte de
  /// `deliveryFee` a propósito: ese es el pago del repartidor urbano y no puede
  /// mezclarse con el flete.
  intercityFee   Float?

  /// El cliente pidió que se la lleven hasta la puerta en la ciudad de destino,
  /// en vez de recogerla él en la taquilla.
  ///
  /// Es una decisión del cliente y se sella: de ella depende si se le cobra
  /// `deliveryFee` (que en un envío intermunicipal paga al repartidor de
  /// DESTINO, no al de origen — en origen el comercio lleva la caja a la
  /// terminal y no hay repartidor que pagar).
  lastMile Boolean   @default(false)
  /// Dónde se entregó la encomienda en la ciudad de destino: el punto real
  /// donde el conductor del bus firmó el acta, tomado de su GPS. Es el origen
  /// del repartidor de última milla — no se inventa una dirección de terminal
  /// que nadie declaró.
  hubLat   Float?
  hubLng   Float?
  hubAt    DateTime?

  /// Cuándo se prometió la entrega, calculado al crear con la hora de corte de
  /// bodega del destino. `etaMinutes` no sirve para esto: «doce horas» dicho a
  /// las cinco de la tarde, con el bus de las cuatro ya ido, es mentira.
  promisedAt DateTime?

  subtotal         Float
  /// Descuento de la promoción de la tienda, SELLADO al crear el pedido: se
  /// guarda en vez de recalcularse, porque cambiar la promoción mañana no
  /// puede reescribir lo que se cobró hoy.
  promoDiscount    Float?
  deliveryFee      Float
  total            Float
  etaMinutes       Int?
  // Tiempo de preparación (min) que el restaurante fija al aceptar el pedido.
  prepMinutes      Int?
  // Momento en que el restaurante aceptó (arranca el contador de preparación).
  acceptedAt       DateTime?
  // Momento en que el restaurante marcó el pedido listo para recoger. Corre en
  // paralelo a los estados de entrega (el conductor puede ir en camino mientras
  // se cocina), por eso es timestamp y no un estado del enum.
  readyAt          DateTime?
  pickupPhotoUrl   String?
  deliveryPhotoUrl String?
  // Cadena de custodia por PIN: el negocio entrega el pedido al repartidor
  // contra `pickupPin`, y el cliente lo recibe contra `deliveryPin`. Nunca se
  // exponen al conductor: él los pide de viva voz y los teclea.
  pickupPin        String?
  deliveryPin      String?
  pickupPinAt      DateTime?
  deliveryPinAt    DateTime?
  hasSignature     Boolean   @default(false)
  customerName     String?
  driverName       String?
  driverPhone      String?
  tipAmount        Float     @default(0)
  tipPaid          Boolean   @default(false)
  rating           Int?
  ratingComment    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pickedUpAt       DateTime?
  deliveredAt      DateTime?

  /// Remito con el que viaja, si es una encomienda ya subida a un despacho.
  manifest FreightManifest?
  user     User?            @relation(fields: [userId], references: [id])
  business Business         @relation(fields: [businessId], references: [id])
  lines    OrderLine[]

  @@index([userId])
  @@index([driverId])
  @@index([operatorId])
  @@index([status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DRIVER_TO_PICKUP
  AT_PICKUP
  /// Va en el despacho de una empresa intermunicipal, camino a la otra ciudad.
  /// Distinto de IN_TRANSIT, que es un repartidor urbano con la caja en la moto.
  IN_INTERCITY_TRANSIT
  /// Llegó a la ciudad de destino y espera al repartidor de última milla.
  /// Solo lo usan los pedidos con `lastMile`: los demás se cierran como
  /// entregados cuando el destinatario firma en la taquilla.
  AT_DESTINATION_HUB
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model OrderLine {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  quantity       Int
  unitPrice      Float
  subtotal       Float
  // Resumen legible de las opciones elegidas (ej: "Grande · +Queso · Sin cebolla").
  // El `unitPrice` ya incluye los deltas de esas opciones.
  //
  // Lo GENERA el servidor a partir de `optionIds`, nunca la app: si el texto
  // viniera del teléfono, la cocina leería lo que el cliente dijo haber
  // elegido y no lo que realmente se cobró.
  optionsSummary String?
  /// Opciones elegidas, por id. Es el dato; el resumen de arriba es su
  /// presentación. Con esto el servidor recalcula el precio, rechaza una
  /// opción que el negocio acaba de agotar, y el restaurante puede saber
  /// cuántas veces le pidieron extra queso.
  optionIds      String[]
  /// Lo que en el mostrador se dice de viva voz: "sin cebolla", "bien cocida".
  /// Va a la cocina tal cual.
  notes          String?

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_lines")
}

// ── Viajes de movilidad ───────────────────────────────────────────────────────

model Trip {
  id                 String        @id @default(cuid())
  requestRef         String        @unique
  passengerId        String?
  driverId           String?
  vehicleId          String?
  serviceType        TransportType
  status             TripStatus    @default(SEARCHING)
  originAddress      String
  originLat          Float
  originLng          Float
  destAddress        String
  destLat            Float
  destLng            Float
  // Paradas intermedias del trayecto: [{name, lat?, lng?, order}] (máx. 6).
  // Mismo formato que el intermunicipal y los cupos, para que `lib/trip-stops`
  // valide y lea los tres igual.
  stops              Json?
  estimatedFare      Float
  surgeMultiplier    Float         @default(1.0)
  /// Cómo acordó pagar el pasajero. Los valores los define `lib/metodos-pago`.
  /// Null = efectivo (viajes anteriores a este campo). Salvo 'en_linea', que sí
  /// cobra Wompi, el dinero se mueve entre pasajero y conductor y la comisión
  /// se descuenta igual de la billetera del conductor.
  paymentMethod      String?
  finalFare          Float?
  /// Cupón aplicado, si lo hubo. Se sella el CÓDIGO y el MONTO, no el
  /// porcentaje: cambiar mañana la promoción no puede reescribir lo que se
  /// cobró hoy. El descuento sale de NUESTRA comisión — `finalFare`,
  /// `netEarning` y `commission` son los mismos que sin cupón, y lo que paga
  /// el pasajero se deriva restando (ver `lib/descuento-viaje`).
  promoCode          String?
  promoDiscount      Int?
  /// Para cuándo lo reservó el pasajero. Null = viaje inmediato.
  scheduledFor       DateTime?
  /// Cuándo hay que empezar a buscar conductor: la hora reservada MENOS la
  /// antelación (ver `lib/viaje-programado`). Se guarda calculado para que el
  /// barrido sea una consulta indexada y no tenga que hacer aritmética por
  /// fila.
  searchFrom         DateTime?
  distanceKm         Float?
  etaMinutes         Int?
  cancelReason       String?
  pickupPhotoUrl     String?
  deliveryPhotoUrl   String?
  recipientName      String?
  recipientPhone     String?
  packageDescription String?
  passengerName      String?
  passengerRating    Float?
  /// Lo que el pasajero destacó del conductor («Puntual», «Carro limpio»).
  /// Claves del catálogo cerrado de `lib/elogios`; máximo tres. Se sellan en
  /// el viaje que las produjo, que es lo que las hace auditables: el conteo
  /// del perfil se RECALCULA de aquí, nunca se suma encima.
  ratingTags         Json?
  netEarning         Float?
  commission         Float?
  tipAmount          Float         @default(0)
  tipPaid            Boolean       @default(false)
  rating             Int?
  ratingComment      String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  acceptedAt         DateTime?
  startedAt          DateTime?
  arrivedAt          DateTime?
  completedAt        DateTime?

  // Empresa bajo la cual se prestó el servicio (trazabilidad legal + liquidación).
  operatorId String?

  passenger User?    @relation("TripPassenger", fields: [passengerId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id])
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  // Plaza donde se ORIGINÓ el viaje, sellada al crearlo con el mismo criterio
  // que usa la app para saber en qué municipio estás (centroide más cercano).
  // Se guarda en vez de calcularse al consultar para que el panel pueda filtrar
  // por ciudad con un índice, y para que cambiar un centroide mañana no
  // reescriba a qué plaza perteneció un viaje del mes pasado.
  citySlug      String?
  // Custodia del ENVÍO: el PIN lo dicta quien RECIBE el paquete. Sin él, el
  // repartidor no puede cerrar la entrega. Solo se genera para serviceType
  // ENVIOS: un pasajero no necesita PIN para bajarse del carro.
  deliveryPin   String?
  deliveryPinAt DateTime?

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
  @@index([operatorId])
  @@index([citySlug])
  /// El barrido de programados corre cada minuto: sin esto sería un recorrido
  /// completo de la tabla sesenta veces por hora.
  @@index([status, searchFrom])
  @@map("trips")
}

enum TransportType {
  TAXI
  MOTO
  PARTICULAR
  ENVIOS
  MANDADO
}

enum WorkMode {
  PASAJERO
  PEDIDO
  PAQUETE
  MANDADO
}

enum TripStatus {
  /// Reservado para más tarde. Todavía no se le ofrece a nadie: el barrido lo
  /// pasa a SEARCHING con antelación, para que a la hora acordada el carro
  /// esté en la puerta y no empezando a buscarse.
  SCHEDULED
  SEARCHING
  ACCEPTED
  ARRIVING
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ── Ganancias del conductor ───────────────────────────────────────────────────

model DriverEarning {
  id         String   @id @default(cuid())
  driverId   String
  date       DateTime @db.Date
  grossFare  Float
  commission Float
  /// Lo que GANÓ ese día, cobrara quien cobrara. Es la cifra del panel de
  /// ganancias, y NO es lo que puede retirar: ver las dos de abajo.
  netEarning Float
  tripCount  Int
  /// Lo que ZIPA recaudó y tiene que girarle (solo los servicios pagados en
  /// línea). Antes se usaba `netEarning` para esto, y como se escribía también
  /// en los viajes en efectivo, la billetera le debía al conductor una plata
  /// que él ya tenía en el bolsillo. Ver `lib/saldo-conductor.ts`.
  platformHeld Float  @default(0)
  /// La comisión de los servicios que cobró él de su mano (efectivo, Nequi,
  /// transferencia): eso NO se le debe, se le debe A NOSOTROS.
  driverOwes   Float  @default(0)
  createdAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([driverId, date])
  @@index([driverId])
  @@map("driver_earnings")
}

// ── Retiros (payouts) del conductor ───────────────────────────────────────────
//
// El conductor acumula ganancias netas en driver_earnings. Cuando solicita un
// retiro se crea un Payout en estado REQUESTED contra su saldo disponible
// (neto acumulado − retiros ya solicitados/procesando/pagados). La operación lo
// procesa desde el panel /admin y marca PAID con la referencia de la
// transferencia. La dispersión bancaria automática (Nequi/Daviplata/ACH) es un
// paso posterior; hoy el saldo y el ciclo de vida del retiro son reales.
model Payout {
  id          String       @id @default(cuid())
  driverId    String
  amount      Float
  status      PayoutStatus @default(REQUESTED)
  /// Canal de pago: 'bank' | 'nequi' | 'daviplata'.
  method      String?
  /// Snapshot del destino (banco/cuenta o teléfono) al momento de solicitar.
  accountInfo String?
  notes       String?
  /// Referencia de la transferencia, registrada por la operación al pagar.
  reference   String?
  /// Teléfono del admin que procesó el retiro.
  processedBy String?
  requestedAt DateTime     @default(now())
  processedAt DateTime?

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([status])
  @@map("payouts")
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

// ── Direcciones guardadas del usuario ─────────────────────────────────────────

model Address {
  id          String  @id @default(cuid())
  userId      String
  alias       String
  fullAddress String
  lat         Float?
  lng         Float?
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ── Mandados ──────────────────────────────────────────────────────────────────

model Errand {
  id               String         @id @default(cuid())
  requestRef       String         @unique
  userId           String
  driverId         String?
  // Empresa del conductor al momento de aceptar (sellado para liquidación).
  operatorId       String?
  category         ErrandCategory
  description      String
  pickupAddress    String
  dropoffAddress   String
  // Punto de recogida. Antes viajaba solo en la petición y se usaba en memoria
  // para lanzar la búsqueda: en cuanto el ciclo moría (un redeploy), no había
  // forma de reanudarlo donde tocaba y el mandado se habría ofrecido al centro
  // del pueblo. Guardarlo también permite pintar el mapa y medir el recorrido.
  pickupLat        Float?
  pickupLng        Float?
  serviceFee       Float          @default(6000)
  purchaseBudget   Float?
  actualCost       Float?
  notes            String?
  status           ErrandStatus   @default(SEARCHING)
  proofPhotoUrl    String?
  deliveryPhotoUrl String?
  // Cadena de custodia por PIN (ver Order): recogida y entrega.
  pickupPin        String?
  deliveryPin      String?
  pickupPinAt      DateTime?
  deliveryPinAt    DateTime?
  hasSignature     Boolean        @default(false)
  driverName       String?
  driverPhone      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  acceptedAt       DateTime?
  deliveredAt      DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([driverId])
  @@index([operatorId])
  @@index([status])
  @@map("errands")
}

enum ErrandCategory {
  PHARMACY
  GROCERIES
  DOCUMENTS
  PAYMENTS
  FOOD
  SHOPPING
  OTHER
}

enum ErrandStatus {
  SEARCHING
  ACCEPTED
  SHOPPING
  ON_THE_WAY
  DELIVERED
  CANCELLED
}

// ── Viajes Intermunicipales ────────────────────────────────────────────────────

model IntercityBooking {
  id             String          @id @default(cuid())
  requestRef     String          @unique
  userId         String
  driverId       String?
  // Slug del municipio (ver model Municipality). Era un enum de 7 valores.
  origin         String
  destination    String
  departureTime  DateTime
  seats          IntercitySeats
  offeredFare    Float
  counterFare    Float?
  finalFare      Float?
  status         IntercityStatus @default(SEARCHING)
  pickupAddress  String?
  dropoffAddress String?
  notes          String?
  // Paradas intermedias del trayecto: [{name, lat?, lng?, order}] (máx. 6).
  stops          Json?
  driverName     String?
  driverPhone    String?
  driverVehicle  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  confirmedAt    DateTime?
  completedAt    DateTime?
  rating         Int?
  ratingComment  String?

  // Empresa bajo la cual se prestó el servicio (troncales legales + liquidación).
  operatorId String?

  user      User      @relation(fields: [userId], references: [id])
  // Marcas de la trazabilidad: alimentan la línea de tiempo del pasajero.
  enRouteAt DateTime?
  arrivedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([operatorId])
  @@map("intercity_bookings")
}

enum IntercitySeats {
  ONE
  TWO
  THREE
  FLEET
}

enum IntercityStatus {
  SEARCHING
  DRIVER_FOUND
  CONFIRMED
  // El pasajero espera en su casa: estos dos estados son los que más le
  // importan y eran justamente los que faltaban. Sin ellos solo veía
  // "confirmado" durante una hora y luego "en viaje".
  DRIVER_TO_PICKUP
  AT_PICKUP
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ── Viajes compartidos (Modelo A) ─────────────────────────────────────────────

model PooledTrip {
  id                 String            @id @default(cuid())
  tripRef            String            @unique
  driverId           String
  driverName         String
  driverPhone        String
  vehicleDescription String
  /// Intermunicipal (lo de siempre) o puesto de taxi urbano. El default deja
  /// intactas todas las salidas ya publicadas.
  kind               PooledKind        @default(INTERCITY)
  // Slug del municipio (ver model Municipality).
  //
  // En una salida URBANA los dos guardan el MISMO slug: el trayecto es dentro
  // de la ciudad y los extremos de verdad son `originLabel`/`destLabel` con
  // sus coordenadas. Se conserva la ciudad aquí para que el índice y el filtro
  // por plaza sigan valiendo sin una columna nueva.
  origin             String
  destination        String
  /// Cómo se llama la ruta urbana («Terminal → Universidad»). NULL en las
  /// intermunicipales, donde el nombre son las dos ciudades.
  routeName          String?
  /// Los extremos de la ruta urbana, tal como los escribió el conductor.
  originLabel        String?
  destLabel          String?
  /// Dónde caen esos extremos. Se geocodifican al publicar para poder medir la
  /// carrera sola y dibujar el trayecto; quedan NULL si no se pudieron
  /// resolver, y entonces la app no pinta mapa en vez de pintar uno falso.
  originLat          Float?
  originLng          Float?
  destLat            Float?
  destLng            Float?
  /// Lo que costaría ese mismo trayecto en una carrera sola, SELLADO al
  /// publicar. Es de donde salió el tope del puesto, así que guardarlo es lo
  /// que permite auditar el precio después y decirle al pasajero cuánto se
  /// ahorra. Si la tarifa del decreto cambia mañana, esta salida siguió la de
  /// su día.
  soloFareRef        Float?
  departureTime      DateTime
  totalSeats         Int
  /// Con qué vehículo viaja, para dibujar el mapa de sillas. NULL = salida sin
  /// numeración: se vende por cantidad de cupos, como se hacía antes de que
  /// existiera la selección de silla. Las salidas ya publicadas se quedan así
  /// a propósito — cambiarles el modo a mitad de venta dejaría a los que ya
  /// compraron sin saber dónde se sientan.
  seatType           VehicleType?
  /// Filas de pasajeros del vehículo, que la empresa ajusta a su flota. NULL =
  /// las del vehículo típico de ese tipo.
  seatRows           Int?
  /// Distribución real del vehículo de ESTA empresa: `{izquierda, derecha,
  /// filas, frenteIzquierda?, frenteDerecha?, fondoCorrido?, bano?}`.
  /// Ver `lib/mapa-asientos.ts`.
  ///
  /// NULL = la salida se publicó con el molde fijo del tipo, y se sigue
  /// dibujando con él: cambiarle el mapa a una salida a mitad de venta dejaría
  /// a quien ya compró sin saber dónde se sienta, y la discusión sería a bordo.
  seatConfig         Json?
  /// Si la salida recoge al pasajero en su casa (puerta a puerta). NULL = no
  /// se declaró y se deduce del vehículo: las VAN sí, las busetas y buses no,
  /// y las salidas sin vehículo declarado también sí, que es como han
  /// funcionado siempre. Ver `lib/recogida-salida.ts`.
  doorToDoor         Boolean?
  /// Dónde y a qué hora sube el pasajero: `[{id,name,address?,time,lat?,lng?}]`
  /// (máx. 6). NO son las paradas de `stops`, que son los municipios por los
  /// que pasa el bus: estos están en la ciudad de origen y sirven para
  /// abordar. Ver `lib/puntos-embarque.ts`.
  boardingPoints     Json?
  /// Qué trae el vehículo: `["aire","usb",…]` del catálogo de
  /// `lib/amenidades.ts`. Va en la SALIDA y no en la empresa porque dentro de
  /// la misma flota un bus tiene aire y la buseta vieja no. El baño no se
  /// guarda aquí: se deriva de `seatConfig.bano` para que el chip no
  /// contradiga al plano.
  amenities          Json?
  /// Encomiendas que viajan en la bodega de esta salida.
  manifests          FreightManifest[]
  farePerSeat        Float
  maxFarePerSeat     Float
  allowFleet         Boolean           @default(false)
  status             PooledTripStatus  @default(OPEN)
  notes              String?
  // Paradas intermedias de la salida: [{name, lat?, lng?, order}] (máx. 6).
  stops              Json?
  // Empresa que publicó la salida (null = conductor particular). Sin FK,
  // mismo patrón que IntercityBooking.operatorId.
  operatorId         String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  bookings        SeatBooking[]
  seatAssignments SeatAssignment[]

  @@index([driverId])
  @@index([status])
  @@index([origin, destination])
  @@index([operatorId])
  // La búsqueda del pasajero siempre filtra por tipo: si no lo hiciera, los
  // puestos urbanos saldrían mezclados en «ver todas las salidas».
  @@index([kind, origin, status])
  @@map("pooled_trips")
}

/// Una silla vendida de una salida.
///
/// ⚠ ESTA TABLA ES LA GARANTÍA CONTRA LA DOBLE VENTA, no la comprobación en
/// código. Dos personas comprando a la vez pasan las dos la validación —entre
/// mirar y escribir hay milisegundos— y sin el índice único las dos se llevan
/// la silla 7, se presentan al bus y la pelea es a bordo. Con él, la segunda
/// choca contra la base y se le dice que elija otra.
///
/// Es una fila por silla, no un array en la reserva: un `String[]` no se puede
/// hacer único por elemento en PostgreSQL, y esa es justo la garantía que hace
/// falta. Mismo patrón que `FreightManifest.orderId`.
model SeatAssignment {
  id         String @id @default(cuid())
  tripId     String
  seatNumber Int
  bookingId  String

  trip    PooledTrip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking SeatBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tripId, seatNumber])
  @@index([bookingId])
  @@map("seat_assignments")
}

model SeatBooking {
  id             String            @id @default(cuid())
  tripId         String
  userId         String
  passengerName  String
  passengerPhone String
  seatsBooked    Int
  pickupAddress  String?
  notes          String?
  status         SeatBookingStatus @default(CONFIRMED)
  bookedAt       DateTime          @default(now())
  /// Cómo calificó el pasajero esta salida (1-5) y qué escribió. La nota vive
  /// en la fila del servicio —como en `Trip` y en `Order`— y el promedio de la
  /// empresa se RECALCULA de aquí, nunca se va sumando encima.
  rating         Int?
  ratingComment  String?
  /// El punto de embarque que eligió, SELLADO: `{id,name,address?,time}`. Se
  /// copia y no se referencia porque si la empresa mueve el punto o le cambia
  /// la hora mañana, a esta persona le dijeron otra cosa y es la que tiene que
  /// seguir viendo.
  boardingPoint  Json?
  /// Lo que costó, sellado al reservar. Antes la reserva no guardaba ningún
  /// importe: si la empresa subía la tarifa, «Mis reservas» le mostraba al
  /// pasajero un precio que él nunca aceptó.
  fareTotal      Float?
  /// Descuento aplicado y con qué código. Lo pone la EMPRESA que emitió el
  /// cupón: en un pasaje de bus el dinero no pasa por la plataforma, así que
  /// no hay comisión de la que descontarlo (ver `lib/cupon-pasaje.ts`).
  discount       Float    @default(0)
  promoCode      String?
  /// Quién viaja en cada silla: `[{tipoDoc,documento,nombre}]`, uno por
  /// puesto. Ver `lib/pasajeros-tiquete.ts`. Es la planilla con la que la
  /// empresa responde por quién iba a bordo. NULL en las reservas hechas desde
  /// una app que aún no los manda: se muestra como «sin datos», no se inventa.
  passengers     Json?

  trip  PooledTrip       @relation(fields: [tripId], references: [id])
  user  User             @relation(fields: [userId], references: [id])
  /// Qué sillas concretas le tocaron. Vacío en las salidas sin numeración,
  /// donde `seatsBooked` sigue siendo todo lo que se sabe.
  seats SeatAssignment[]

  @@index([tripId])
  @@index([userId])
  @@map("seat_bookings")
}

enum PooledTripStatus {
  OPEN
  FULL
  DEPARTED
  COMPLETED
  CANCELLED
}

/// De qué tipo es la salida por puestos.
///
/// INTERCITY: de un municipio a otro (lo que existía). URBANO: el puesto de
/// taxi dentro de una ciudad — los dos extremos son puntos, no municipios, y
/// la tarifa se mide contra la carrera sola (ver `lib/puesto-urbano.ts`).
enum PooledKind {
  INTERCITY
  URBANO
}

enum SeatBookingStatus {
  CONFIRMED
  CANCELLED
}

// ── Pagos (Wompi) ─────────────────────────────────────────────────────────────

model Payment {
  id            String   @id @default(cuid())
  referenceCode String   @unique
  amount        Float
  currency      String   @default("COP")
  description   String
  clientId      String
  orderId       String?
  tripId        String?
  status        String   @default("pending")
  paymentUrl    String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
  @@map("payments")
}

// ── Eventos de emergencia (SOS / compartir viaje) ─────────────────────────────

model EmergencyEvent {
  id        String        @id @default(cuid())
  userId    String?
  driverId  String?
  tripId    String?
  lat       Float
  lng       Float
  type      EmergencyType @default(PANIC)
  createdAt DateTime      @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  @@index([userId])
  @@index([driverId])
  @@index([tripId])
  @@map("emergency_events")
}

enum EmergencyType {
  PANIC // botón de pánico pulsado
  SHARE // viaje compartido con contacto de confianza
}

// ── Empresas de transporte (operadores) + flota ───────────────────────────────
//
// Una Operator es una empresa de taxi o de transporte intermunicipal habilitada.
// De ella cuelgan su flota (Vehicle.operatorId), sus conductores afiliados
// (Driver.operatorId), sus documentos legales, los usuarios de su portal y las
// rutas que está autorizada a operar. Cada viaje se sella con operatorId para
// trazabilidad legal y liquidación. Ver docs/ESTRUCTURA_EMPRESAS_FLOTAS.md.

model Operator {
  id                    String         @id @default(cuid())
  legalName             String
  nit                   String         @unique
  tradeName             String?
  // EMPRESA = persona jurídica (razón social + NIT); PERSONA = dueño natural
  // de varios vehículos (nombre completo + cédula en los mismos campos).
  kind                  OperatorKind   @default(EMPRESA)
  type                  OperatorType
  status                OperatorStatus @default(PENDING)
  isVerified            Boolean        @default(false)
  habilitacionNo        String? // número de resolución de habilitación (Mintransporte)
  habilitacionExpiresAt DateTime?
  contactName           String?
  contactPhone          String?
  contactEmail          String?
  city                  String?
  commissionRate        Float? // override de comisión de plataforma (null = global)
  /// Condiciones del tiquete que publica la empresa: equipaje, mascotas,
  /// menores, cancelación. Ver `lib/politicas-tiquete.ts`. NULL = no las ha
  /// publicado, y la app lo dice — no se inventa una política por defecto,
  /// que sería una condición reclamable que la empresa nunca fijó.
  policies              Json?
  /// Cómo cobra la empresa el pasaje: `{medios:[...], detalle?}`. Ver
  /// `lib/cobro-pasaje.ts`. La plata NO pasa por ZIPA —esto es lo que la
  /// empresa declara, publicado tal cual—, y NULL significa que no lo ha
  /// publicado: la app lo dice en vez de suponer «efectivo al abordar», que
  /// dejaría a la gente sin efectivo en la puerta del bus de una empresa que
  /// cobra por transferencia.
  paymentInfo           Json?
  /// Reputación REAL de la empresa, promediada de sus servicios calificados
  /// (salidas programadas + intermunicipales). `null` mientras nadie la haya
  /// calificado: la app dice «Nuevo». Nunca un 5,0 de fábrica — ese error ya
  /// se pagó dos veces, en `Business` y en `Driver`.
  rating                Float?
  ratingCount           Int            @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  documents   OperatorDocument[]
  members     OperatorMember[]
  routes      OperatorRoute[]
  vehicles    Vehicle[]
  drivers     Driver[]
  assignments FleetAssignment[]

  @@map("operators")
}

model OperatorDocument {
  id              String          @id @default(cuid())
  operatorId      String
  type            OperatorDocType
  fileUrl         String
  status          DocumentStatus  @default(PENDING)
  expiresAt       DateTime?
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  uploadedAt      DateTime        @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@index([status])
  @@map("operator_documents")
}

model OperatorMember {
  id         String       @id @default(cuid())
  operatorId String
  phone      String // login OTP al portal de empresa
  name       String?
  role       OperatorRole @default(VIEWER)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@unique([operatorId, phone])
  @@index([operatorId])
  @@map("operator_members")
}

model OperatorRoute {
  id         String   @id @default(cuid())
  operatorId String
  originCity String
  destCity   String
  authorized Boolean  @default(false)
  createdAt  DateTime @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@unique([operatorId, originCity, destCity])
  @@index([operatorId])
  @@map("operator_routes")
}

model FleetAssignment {
  id         String    @id @default(cuid())
  operatorId String
  driverId   String
  vehicleId  String
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  active     Boolean   @default(true)

  operator Operator @relation(fields: [operatorId], references: [id])
  driver   Driver   @relation(fields: [driverId], references: [id])
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id])

  @@index([operatorId])
  @@index([driverId])
  @@index([vehicleId])
  @@map("fleet_assignments")
}

enum OperatorKind {
  EMPRESA // persona jurídica
  PERSONA // dueño natural de vehículos (2-3 camiones/turbos propios)
}

enum OperatorType {
  TAXI
  INTERCITY
  MIXED
  CARGA // empresa de transporte de carga (mulas, turbos, camiones)
}

enum OperatorStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum OperatorDocType {
  HABILITACION
  RUT
  CAMARA_COMERCIO
  INSURANCE
  OTHER
}

enum OperatorRole {
  OWNER
  DISPATCHER
  VIEWER
}

enum EmploymentType {
  OWN
  AFFILIATED
}

// ── Fletes de carga (cliente ↔ empresa/dueño de camiones) ─────────────────────

enum FreightStatus {
  REQUESTED // publicado por el cliente, visible para las flotas de carga
  ACCEPTED // una empresa/dueño lo tomó (conductor + vehículo asignados)
  IN_PROGRESS // carga en ruta
  COMPLETED // entregado y liquidado (comisión de plataforma descontada)
  CANCELLED
}

model FreightRequest {
  id               String        @id @default(cuid())
  clientId         String
  clientName       String?
  clientPhone      String?
  originAddress    String
  destAddress      String
  // Ciudades (texto libre): iguales u omitidas = acarreo urbano; distintas =
  // flete intermunicipal. La fecha futura lo vuelve "programado".
  originCity       String?
  destCity         String?
  cargoDescription String
  weightKg         Int
  vehicleType      VehicleType // TURBO | CAMION | MULA
  offeredPrice     Float
  scheduledFor     DateTime? // null = lo antes posible
  status           FreightStatus @default(REQUESTED)
  // Cadena de custodia por PIN (ver Order): el remitente entrega la carga
  // contra `pickupPin` y el destinatario la recibe contra `deliveryPin`.
  pickupPin        String?
  deliveryPin      String?
  pickupPinAt      DateTime?
  deliveryPinAt    DateTime?
  operatorId       String?
  driverId         String?
  vehicleId        String?
  finalPrice       Float?
  commission       Float?
  netEarning       Float?
  // Coordenadas de la trayectoria (para dibujar el mapa del flete). Se
  // resuelven al crear el flete desde el centroide de la ciudad (fallback
  // Pamplona); permiten mostrar origen→destino en la app del conductor.
  originLat        Float?
  originLng        Float?
  destLat          Float?
  destLng          Float?
  // Fecha comprometida de entrega. Sin ella no se puede medir cumplimiento:
  // "llegó tarde" es una opinión hasta que hay una hora contra la cual medir.
  promisedAt       DateTime?
  createdAt        DateTime      @default(now())
  acceptedAt       DateTime?
  // Salida real (paso a IN_PROGRESS). Separa "aceptado pero sin salir de
  // bodega" de "en ruta" — es justo la demora que discute el cliente, y con
  // solo acceptedAt/completedAt quedaba escondida dentro del viaje.
  startedAt        DateTime?
  completedAt      DateTime?

  events      FreightEvent[]
  // Viaje de carga creado al aceptar la solicitud: ahí vive toda la
  // trazabilidad (rastro, gastos, tiempos, remitos y cobro).
  cargoTripId String?        @unique
  cargoTrip   CargoTrip?     @relation(fields: [cargoTripId], references: [id])

  @@index([status])
  @@index([operatorId])
  @@index([clientId])
  @@map("freight_requests")
}

// Trazabilidad del flete: eventos que el conductor registra en ruta
// (tanqueos de combustible, paradas, notas) para control total de la empresa.
// La bitácora cuelga del VIAJE de carga (unidad operativa) o, para los fletes
// del marketplace anteriores a la unificación, directamente del flete. Los dos
// enlaces son opcionales y se lee por cualquiera de ellos.
model FreightEvent {
  id          String   @id @default(cuid())
  freightId   String?
  cargoTripId String?
  driverId    String
  // FUEL | STOP | NOTE
  type        String
  lat         Float?
  lng         Float?
  address     String?
  // Solo FUEL: monto en COP, galones y odómetro al tanquear.
  amountCop   Float?
  gallons     Float?
  odometerKm  Float?
  note        String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  freight   FreightRequest? @relation(fields: [freightId], references: [id])
  cargoTrip CargoTrip?      @relation(fields: [cargoTripId], references: [id])

  @@index([freightId])
  @@index([cargoTripId])
  @@index([driverId])
  @@map("freight_events")
}

// ─── Rastro GPS histórico ─────────────────────────────────────────────────────
//
// `Driver.lastLat/lastLng` es UN punto que cada heartbeat sobreescribe: sirve
// para saber dónde está el conductor ahora, pero no por dónde pasó. Sin rastro
// no hay recorrido que mostrar en un reclamo, ni kilómetros reales recorridos
// (el flete solo conoce origen y destino), ni tiempos por tramo.
//
// Se graba SOLO con un servicio EN CURSO: un punto sin dueño no le sirve a
// nadie y multiplicaría el volumen por cada conductor conectado sin viaje. El
// heartbeat llega cada 4 s, así que además se filtra por tiempo y distancia
// mínimos (TRACK_MIN_INTERVAL_S / TRACK_MIN_DIST_M) y se purga por retención
// (TRACK_RETENTION_DAYS) — ver track.service.ts.
model DriverTrackPoint {
  id             String   @id @default(cuid())
  driverId       String
  lat            Float
  lng            Float
  // Servicio al que pertenece el punto: 'trip' | 'intercity' | 'freight'.
  serviceKind    String
  serviceId      String
  // Se copia para poder filtrar por flota sin recorrer el servicio.
  operatorId     String?
  // Metros desde el punto anterior del mismo servicio. Permite sumar la
  // distancia real recorrida sin recalcular toda la traza en cada consulta.
  metersFromPrev Float?
  at             DateTime @default(now())

  @@index([serviceKind, serviceId, at])
  @@index([driverId, at])
  @@index([operatorId, at])
  @@index([at])
  @@map("driver_track_points")
}

// ─── Remito de salida de mercancía ────────────────────────────────────────────
//
// Reemplaza el formato en papel "SALIDA DE MERCANCÍA": la flota lo arma en el
// portal, el conductor lo confirma bulto por bulto al recoger y al entregar, y
// el destinatario firma la recepción.
//
// El papel solo dice "se recibe a satisfacción": si faltaba un bulto, nadie
// podía probarlo. Aquí cada bulto tiene su medida declarada y su medida
// recibida, así que un faltante o una avería quedan registrados con foto en el
// momento, no en el reclamo.
//
// Las unidades son configurables (rollo/metros para tela, caja/kg para otra
// carga): el formato del cliente es de rollos de tela, pero el modelo no se
// casa con ese negocio.
model FreightManifest {
  id         String  @id @default(cuid())
  operatorId String
  // Consecutivo legible del remito, único por empresa (REM-0001).
  code       String
  // Referencia del lote — en el formato del cliente, "Cross Plus Black".
  reference  String?
  // Bodega o punto de salida ("BODEGA CÚCUTA").
  warehouse  String?

  // Destinatario
  clientName    String
  clientAddress String?
  clientCity    String?

  // Transporte. Se copian del conductor y vehículo al despachar: el remito es
  // un documento y no puede cambiar si mañana el conductor edita su perfil.
  freightId      String?
  driverId       String?
  driverName     String?
  driverIdNumber String?
  vehiclePlate   String?

  // Unidades del negocio: qué es cada renglón y en qué se mide.
  unitLabel    String @default("bulto")
  measureLabel String @default("unidades")

  status ManifestStatus @default(DRAFT)

  // Totales sellados al despachar (el papel los suma a mano; aquí quedan fijos
  // como constancia de lo que salió).
  totalItems   Int?
  totalMeasure Float?

  authorizedBy String?
  notes        String?

  // Recepción
  receivedByName     String?
  receivedByIdNumber String?
  receivedAt         DateTime?
  receiptPhotoUrl    String?
  // Diferencias detectadas al recibir (faltantes + averiados).
  discrepancyCount   Int       @default(0)

  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  items FreightManifestItem[]

  // Viaje al que pertenece esta línea. Un remito puede colgar de un flete del
  // marketplace (`freightId`) o de un viaje propio de la flota (`cargoTripId`),
  // que es como opera una empresa que despacha para un cliente recurrente.
  cargoTripId  String?
  cargoTrip    CargoTrip?  @relation(fields: [cargoTripId], references: [id])
  /// O de una SALIDA DE BUS de pasajeros, que es como opera de verdad una
  /// cooperativa intermunicipal: el bus ya va, la bodega va vacía, y cada
  /// encomienda es margen sobre un costo ya hundido. Antes el remito solo podía
  /// colgar de un viaje de carga, así que esa bodega no se podía vender.
  ///
  /// Excluyentes en la práctica: un remito va en UN vehículo.
  pooledTripId String?
  pooledTrip   PooledTrip? @relation(fields: [pooledTripId], references: [id])
  // Fecha de entrega que va en la cuenta de cobro. Normalmente la sella la
  // conciliación (`receivedAt`), pero se puede fijar a mano al cargar
  // despachos ya entregados en papel.
  deliveredOn  DateTime?

  /// El pedido que viaja en este remito, si el remito nació de una encomienda.
  /// ÚNICO: un pedido no puede ir en dos despachos — si pudiera, dos empresas
  /// cobrarían el mismo envío y nadie sabría en qué bus va la caja.
  orderId String? @unique
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([operatorId, code])
  @@index([operatorId])
  @@index([freightId])
  @@index([cargoTripId])
  @@index([pooledTripId])
  @@index([status])
  @@map("freight_manifests")
}

enum ManifestStatus {
  DRAFT // se está armando en el portal
  DISPATCHED // salió de bodega; el conductor lo lleva
  RECEIVED // entregado y conciliado
  CANCELLED
}

// ─── Viaje de carga ───────────────────────────────────────────────────────────
//
// Un camión sale con mercancía de VARIOS clientes, cada uno con su referencia,
// su destino y su fecha de entrega. El modelo de fletes no podía representarlo:
// `FreightRequest` es un cliente, un origen y un destino.
//
// El viaje agrupa remitos: cada `FreightManifest` es una línea del despacho
// (referencia, destinatario, ciudad de destino, bultos y medida), y el viaje
// aporta lo que es común al camión — de dónde salió, quién lo condujo y el
// peso total de la carga.
//
// El peso va aquí y no en la línea: en el formato del cliente se anota una sola
// vez por viaje, y la aritmética lo confirma (69–78 kg por rollo en todos los
// viajes que lo traen; por línea daría cifras imposibles).
model CargoTrip {
  id          String  @id @default(cuid())
  operatorId  String
  // Consecutivo legible por empresa (1, 2, 3…), como el talonario de papel.
  number      Int
  // "BOGOTA" + "MADRID", "CUCUTA" + "DON LUIS": ciudad y punto de salida.
  originCity  String
  originPlace String?
  // Peso total del camión en kg.
  weightKg    Int?
  // Acarreo urbano: se cobra el viaje, sin rollos ni metros que listar.
  isUrban     Boolean @default(false)

  driverId     String?
  vehicleId    String?
  // Copiados al despachar: un documento no puede cambiar si mañana el
  // conductor edita su perfil (mismo criterio que el remito).
  driverName   String?
  vehiclePlate String?

  // Valor del flete de ESTE viaje: es lo que se cobra por moverlo, y la suma
  // de los viajes es el total de la cuenta. Va aquí y no en la cuenta para que
  // el total esté respaldado por su detalle y se pueda auditar viaje por viaje.
  freightAmount Float?

  // Destino principal del viaje. Las líneas llevan cada una su destinatario y
  // su ciudad; este es el punto contra el que se miden geocerca y desvío.
  destCity String?

  status       CargoTripStatus @default(DRAFT)
  notes        String?
  scheduledAt  DateTime?
  dispatchedAt DateTime?
  // Salida real: separa la espera en bodega del tiempo en ruta, igual que en
  // el flete. Sin ella la demora de cargue queda escondida dentro del viaje.
  startedAt    DateTime?
  // Entrega comprometida: sin una hora contra la cual medir, "llegó tarde" es
  // una opinión.
  promisedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())

  // Cuenta de cobro en la que se facturó (null = todavía sin facturar).
  cobroId String?
  cobro   CobroAccount? @relation(fields: [cobroId], references: [id])

  manifests FreightManifest[]
  // Bitácora de ruta del viaje: tanqueos, peajes, viáticos, paradas y notas.
  events    FreightEvent[]
  // Solicitud del marketplace que originó este viaje (null = despacho propio
  // de la flota). Es el puente que unifica los dos caminos.
  freight   FreightRequest?

  @@unique([operatorId, number])
  @@index([operatorId, createdAt])
  @@index([cobroId])
  @@map("cargo_trips")
}

enum CargoTripStatus {
  DRAFT // se está armando
  DISPATCHED // salió de bodega
  COMPLETED // entregado
  CANCELLED
}

// ─── Cuenta de cobro ──────────────────────────────────────────────────────────
//
// El documento con el que la empresa le factura a su cliente un período:
// «DETALLE DE ENTREGA CUENTA DE COBRO 066». Agrupa los viajes del período y
// lista, viaje por viaje, cada línea con sus rollos, metros, destinatario y
// fecha de entrega.
//
// Al emitirla queda sellada y sus viajes no pueden reasignarse a otra cuenta:
// si se pudiera, dos cuentas podrían cobrar el mismo viaje y la conciliación
// con el cliente dejaría de probar nada.
model CobroAccount {
  id         String      @id @default(cuid())
  operatorId String
  // Número del talonario ("066"): texto, porque el cliente usa ceros a la izquierda.
  number     String
  // A quién se le cobra.
  clientName String
  fromDate   DateTime
  toDate     DateTime
  status     CobroStatus @default(DRAFT)
  issuedAt   DateTime?
  // Quien firma el documento.
  signedBy   String?
  notes      String?
  createdAt  DateTime    @default(now())

  trips    CargoTrip[]
  payments CobroPayment[]

  @@unique([operatorId, number])
  @@index([operatorId, createdAt])
  @@map("cobro_accounts")
}

enum CobroStatus {
  DRAFT // se está armando; se pueden añadir y quitar viajes
  ISSUED // emitida y sellada
  VOID // anulada
}

// ─── Pagos de la cuenta de cobro ──────────────────────────────────────────────
//
// El cliente rara vez paga de una sola vez: lo normal es un anticipo al
// despachar —con el que el transportador cubre combustible y peajes— y el saldo
// contra entrega. Cada pago es una fila; el saldo se DERIVA (total de la cuenta
// menos lo abonado) y nunca se guarda, para que no puedan quedar en desacuerdo.
//
// Un pago registrado no se edita: se anula y se vuelve a cargar. Un recibo que
// cambia de monto después de entregado no prueba nada.
model CobroPayment {
  id         String       @id @default(cuid())
  cobroId    String
  cobro      CobroAccount @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  amount     Float
  kind       PaymentKind  @default(ABONO)
  // Efectivo, transferencia, cheque… texto libre: cada empresa usa los suyos.
  method     String?
  // Número de consignación, comprobante o cheque.
  reference  String?
  notes      String?
  // Soporte escaneado del pago.
  receiptUrl String?
  paidAt     DateTime     @default(now())
  voidedAt   DateTime?
  createdAt  DateTime     @default(now())

  @@index([cobroId, paidAt])
  @@map("cobro_payments")
}

enum PaymentKind {
  ANTICIPO // adelanto antes o al despachar
  ABONO // pago parcial durante el período
  SALDO // cierre de la cuenta
}

// Un renglón del remito: en el formato del cliente, un rollo de tela con su
// metraje. `position` es el número impreso en la tabla (1..100).
model FreightManifestItem {
  id         String  @id @default(cuid())
  manifestId String
  position   Int
  // Medida declarada al despachar (metros, kilos, unidades…).
  measure    Float
  // Identificador del bulto si la bodega lo maneja (lote, serie, código).
  code       String?
  note       String?

  // Conciliación en la entrega. `receivedMeasure` null = aún no conciliado.
  receivedMeasure Float?
  itemStatus      ManifestItemStatus @default(PENDING)
  receivedNote    String?
  photoUrl        String?

  manifest FreightManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)

  @@unique([manifestId, position])
  @@index([manifestId])
  @@map("freight_manifest_items")
}

enum ManifestItemStatus {
  PENDING // despachado, sin conciliar
  OK // recibido conforme
  SHORT // llegó con menos medida de la declarada
  MISSING // no llegó
  DAMAGED // llegó averiado
}

// ─── Chat de viaje (pasajero ↔ conductor) ──────────────────────────────────────
// Mensajería persistente atada a un Trip. senderRole: 'client' | 'driver'.
model TripMessage {
  id         String   @id @default(cuid())
  tripId     String
  senderRole String // 'client' | 'driver'
  senderId   String
  body       String   @default("")
  imageUrl   String? // mensaje con foto (compartir ubicación/estado). null = texto
  createdAt  DateTime @default(now())

  @@index([tripId])
  @@map("trip_messages")
}

// ─── Soporte con tickets ────────────────────────────────────────────────────────
enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id            String           @id @default(cuid())
  // Quién abre el ticket: 'client' | 'driver'.
  requesterKind String
  requesterId   String
  requesterName String?
  subject       String
  category      String           @default("general")
  status        SupportStatus    @default(OPEN)
  messages      SupportMessage[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([requesterKind, requesterId])
  @@index([status])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Autor: 'client' | 'driver' | 'admin'.
  authorKind String
  authorId   String?
  body       String
  createdAt  DateTime      @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

// ── Blindaje legal: términos versionados, consentimientos y DMCA ──────────────

enum LegalDocKind {
  TERMS
  PRIVACY
}

// Documento legal versionado (Términos / Política). El texto vigente lo sirve
// el backend (GET /legal/terms|privacy); publicar una versión nueva desactiva
// la anterior y obliga re-aceptación en el próximo registro/login gateado.
model LegalDocument {
  id          String       @id @default(cuid())
  kind        LegalDocKind
  version     String
  title       String
  body        String
  publishedAt DateTime     @default(now())
  active      Boolean      @default(true)

  @@unique([kind, version])
  @@index([kind, active])
  @@map("legal_documents")
}

// Constancia de aceptación: quién (cliente/conductor/empresa), qué versión,
// cuándo y desde qué IP — soporte probatorio del clickwrap (arbitraje).
model LegalConsent {
  id          String       @id @default(cuid())
  subjectKind String // 'user' | 'driver' | 'operator'
  subjectId   String
  docKind     LegalDocKind
  docVersion  String
  acceptedAt  DateTime     @default(now())
  ip          String?

  @@index([subjectKind, subjectId])
  @@map("legal_consents")
}

// Solicitud de retiro DMCA/derechos de autor sobre contenido subido por
// usuarios (documentos, fotos de entrega/chat/catálogo). El admin la procesa.
model TakedownRequest {
  id            String    @id @default(cuid())
  reporterName  String
  reporterEmail String
  contentUrl    String
  reason        String
  status        String    @default("OPEN") // OPEN | REMOVED | REJECTED
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedBy    String?

  @@index([status])
  @@map("takedown_requests")
}

/// Municipios a los que se puede viajar.
///
/// Antes eran un `enum` con siete valores escritos a mano: cada pueblo nuevo
/// exigía una migración y un despliegue, y las empresas de transporte mueven a
/// TODOS los pueblos. Como tabla, agregar uno es insertar una fila.
model Municipality {
  /// Identificador estable en minúscula y sin tildes: 'pamplona', 'villa-del-rosario'.
  slug           String  @id
  name           String
  department     String
  /// Código DANE, cuando se conoce. Útil para cruzar con fuentes oficiales.
  daneCode       String?
  /// Nombre de la zona con la que la marca se presenta en ese municipio, o null
  /// para usar solo «ZIPA».
  ///
  /// No es una división administrativa: es identidad local. En Pamplona la marca
  /// se presenta como «ZIPA/SANTURBÁN» porque el operador de allí quiere que se
  /// note que la plataforma es de su tierra, y eso vale más que un nombre
  /// genérico. ZIPA va a crecer a otras ciudades, así que la zona vive en la
  /// tabla: sumar una región es insertar o editar una fila, no desplegar código.
  zone           String?
  /// Comisión de la plataforma en ese municipio (0–1), o null para la global.
  ///
  /// Abrir plaza nueva casi siempre exige entrar con una comisión más baja que
  /// la de la ciudad consolidada. Con una constante en el código eso obliga a
  /// desplegar y a que TODAS las ciudades cambien a la vez.
  commissionRate Float?
  /// Centroide del casco urbano. Ancla el matching y el mapa.
  lat            Float
  lng            Float
  /// Permite ocultar un municipio sin borrarlo (y sin perder los viajes viejos).
  isActive       Boolean @default(true)

  @@index([department])
  @@index([name])
  @@map("municipalities")
}

/// Alerta de ruta detectada por el heartbeat: llegada a destino, detención
/// prolongada, desvío del corredor o pérdida de señal con un servicio en curso.
///
/// Vivían en un array en memoria de 200. Cada reinicio de Render las borraba,
/// así que el "control total" que pide una flota de carga se perdía en cada
/// despliegue y solo quedaba rastro en los logs del servidor — donde el dueño
/// de la flota no entra nunca.
model SafetyAlertLog {
  id          String   @id @default(cuid())
  kind        String // geofence | stall | deviation | offline
  driverId    String
  driverName  String
  /// Empresa dueña del servicio. Null = servicio sin flota (cliente directo).
  operatorId  String?
  serviceKind String // trip | intercity | freight | cargo
  serviceId   String
  detail      String
  createdAt   DateTime @default(now())

  @@index([operatorId, createdAt])
  @@index([driverId, createdAt])
  @@map("safety_alerts")
}

// ─── Moderación de contenido de usuario ──────────────────────────────────────
//
// Apple (guía 1.2) y Google Play exigen, en cualquier app con contenido de
// usuario, poder REPORTAR contenido y BLOQUEAR a quien abusa. Y no valen los
// tickets de soporte: un canal genérico no está anclado a un mensaje ni a una
// persona, así que no se puede triar ni actuar sobre lo reportado.
//
// La app tiene contenido de usuario en seis sitios: chat de viajes, pedidos y
// mandados (con fotos), comentario al calificar al conductor, comentario al
// calificar al negocio —que se publica—, elogios, catálogo del comercio y
// adjuntos de soporte.

/// Un reporte sobre algo que alguien publicó o dijo.
model ContentReport {
  id String @id @default(cuid())

  /// Quién reporta. No es una FK porque puede ser un `User` o un `Driver`, y
  /// los dos tienen id propio; el par (kind, id) los distingue.
  reporterKind String // client | driver
  reporterId   String

  /// Qué se reporta. Mismo motivo para no ser FK: el objetivo es un mensaje,
  /// una persona, una reseña o un producto.
  targetKind String // chat_message | driver | passenger | business_review | product | business
  targetId   String

  /// Motivo del catálogo cerrado de `lib/reportes.ts`. Un campo libre no se
  /// puede triar, y sin triaje una cola de moderación es un buzón muerto.
  reason String
  detail String?

  status     String    @default("PENDING") // PENDING | ACTIONED | DISMISSED
  resolution String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetKind, targetId])
  @@map("content_reports")
}

/// Alguien no quiere volver a coincidir con alguien.
///
/// Esto es lo que convierte el bloqueo en algo real y no en un botón: el
/// despacho no vuelve a emparejar al par, en las dos direcciones.
model UserBlock {
  id String @id @default(cuid())

  blockerKind String // client | driver
  blockerId   String
  blockedKind String // driver | client
  blockedId   String

  /// Se guarda el motivo si vino de un reporte, para que el admin entienda el
  /// bloqueo sin cruzar tablas.
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerKind, blockerId, blockedKind, blockedId])
  @@index([blockedKind, blockedId])
  @@map("user_blocks")
}

// ─── WhatsApp: entrada por chat sin instalar la app ──────────────────────────

/// Un mensaje entrante de WhatsApp que ya procesamos.
///
/// Existe por UNA razón: Meta reintenta el webhook cuando no recibe un 200 a
/// tiempo, y un reintento significaría mandarle al pasajero un segundo enlace
/// (confuso, y cada mensaje saliente se paga desde octubre de 2026). El índice
/// único sobre `waMessageId` es la toma atómica: el segundo intento choca
/// contra el índice en vez de duplicar la respuesta.
///
/// De paso es el contador que permite topar cuántas respuestas se le mandan a
/// un mismo teléfono al día: sin eso, quien escriba cien veces se gasta el
/// presupuesto mensual de mensajes de toda la operación.
model WhatsappInbound {
  id String @id @default(cuid())

  /// El id que asigna Meta al mensaje (`wamid...`). Único = antirreintento.
  waMessageId String @unique
  /// Teléfono del remitente en E.164, ya normalizado.
  fromPhone   String
  /// Qué se decidió hacer: respondido | ignorado:<motivo>. Deja rastro de por
  /// qué un mensaje no tuvo respuesta, que si no es imposible de diagnosticar.
  outcome     String

  receivedAt DateTime @default(now())

  @@index([fromPhone, receivedAt])
  @@map("whatsapp_inbound")
}

/// Por dónde va la conversación de WhatsApp de un teléfono.
///
/// Antes esto no existía y era correcto: con dos pasos —pedir ubicación, mandar
/// enlace— bastaba con mirar la fila del mensaje anterior. Ahora la conversación
/// entera vive en WhatsApp (origen, destino, precio, confirmación), así que hay
/// que saber qué se está esperando de cada quien.
///
/// UNA FILA POR TELÉFONO, que se reescribe. No es un historial: es dónde está
/// esa persona AHORA. El historial de lo que se decidió con cada mensaje ya lo
/// guarda `whatsapp_inbound`, y duplicarlo aquí daría dos versiones de la misma
/// verdad.
model WhatsappConversation {
  /// El teléfono en E.164 es la clave: una persona, una conversación.
  phone String @id

  /// inicio | esperando_origen | esperando_destino | esperando_confirmacion |
  /// viaje_en_curso. Ver `lib/whatsapp-flujo.ts`.
  state String @default("inicio")

  /// Punto de recogida que mandó con el botón de ubicación.
  originLat   Float?
  originLng   Float?
  originLabel String?

  /// A dónde va, ya resuelto a coordenadas. El texto se guarda tal como lo
  /// escribió porque es lo que se le muestra para confirmar: si se le enseñara
  /// la dirección normalizada por Google, no reconocería su propio destino.
  destText String?
  destLat  Float?
  destLng  Float?

  /// Lo cotizado y aceptado. Se guarda para que el viaje se cree con lo MISMO
  /// que la persona vio en pantalla; recalcular al confirmar podría dar otro
  /// número, y el precio cambiado después de decir que sí es la peor sorpresa.
  category String?
  fare     Int?

  /// El viaje que salió de esta conversación, mientras esté en curso.
  tripId String?

  updatedAt DateTime @updatedAt

  @@map("whatsapp_conversations")
}

/// Enlace de un solo uso para entrar a la app web sin escribir el código OTP.
///
/// El teléfono ya viene verificado por Meta (nadie escribe desde un número que
/// no controla), así que repetir el OTP sería pedirle al pasajero que pruebe
/// algo que ya está probado. Lo que NO se hace es meter el token de sesión en
/// la URL: un enlace de chat se reenvía, se ve en la vista previa y queda en el
/// historial. Va un código opaco de un solo uso y con caducidad corta, que se
/// canjea por el token real contra el backend.
model MagicLink {
  id String @id @default(cuid())

  /// Código opaco que viaja en la URL. Único: el canje es un updateMany con
  /// guarda sobre `usedAt`, así que dos pestañas abiertas no dan dos sesiones.
  code   String @unique
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Por dónde se emitió (hoy siempre `whatsapp`).
  channel String

  /// Punto de recogida que el pasajero mandó con el botón de ubicación de
  /// WhatsApp, para que llegue a la app ya puesto y solo tenga que elegir el
  /// destino. Escribir una dirección en un teclado es la parte que más gente
  /// abandona; tocar un botón, no.
  ///
  /// Va AQUÍ y no en la URL: un enlace de chat se reenvía, y con las
  /// coordenadas dentro se estaría reenviando dónde está esa persona.
  originLat   Float?
  originLng   Float?
  /// Nombre o dirección que WhatsApp adjunta a veces. Solo para mostrar.
  originLabel String?

  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("magic_links")
}
